# ========================================
# MongoDB Configuration
# ========================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=videogames_recommender

# ========================================
# LLM Configuration (CodingBuddy)
# ========================================
LLM_API_ENDPOINT=https://ia-research-dev.codingbuddy-xxxxx.com/research/llm/openai/clients
LLM_API_KEY=your_codingbuddy_api_key_here
LLM_USER_EMAIL=your_email@example.com
LLM_MODEL=gpt-5

# ========================================
# API & Session Timeouts
# ========================================
API_TIMEOUT=60
SESSION_TIMEOUT=3600

# ========================================
# Server Configuration
# ========================================
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# RAG Configuration
TOP_K_RESULTS=5
MAX_TOKENS=1000
TEMPERATURE=0.7

# Logging
LOG_LEVEL=INFO
